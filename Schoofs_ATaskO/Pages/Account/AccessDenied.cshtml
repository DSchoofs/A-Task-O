@page
@model Schoofs_ATaskO.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Zugriff verweigert";
}

<div class="page-container">
    <div class="form-container">
        <h1>Zugriff verweigert</h1>
        <p>Du hast keine Berechtigung, auf diesen Bereich zuzugreifen.</p>

        <div class="form-actions mt-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Index" class="btn btn-primary">Zurück zum Dashboard</a>
            }
            else
            {
                <a asp-page="/Account/Login" class="btn btn-primary">Zur Anmeldung</a>
            }
        </div>
    </div>
</div>