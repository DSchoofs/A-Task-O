@page
@model Schoofs_ATaskO.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-container">
    <div class="form-container wide-container dashboard-container">
        <div class="page-header">
            <div>
                <h1>Dashboard</h1>

                @if (!string.IsNullOrWhiteSpace(Model.Dashboard.UserName))
                {
                    <p class="dashboard-welcome">
                        Guten Tag, @Model.Dashboard.UserName.
                        Heute ist @Model.Dashboard.Today.ToString("dddd, dd.MM.yyyy").
                    </p>
                }
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="dashboard-admin-actions">
                    <a asp-page="/Admin/Tasks/Create" class="save-button">Aufgabe anlegen</a>

                    @if (Model.CanCreateDemoData)
                    {
                        <button type="button" class="save-button" id="createDemoDataButton">Demo-Daten anlegen</button>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="success-message" role="alert">
                @Model.SuccessMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-message" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <div class="dashboard-sections">
            <section class="dashboard-section dashboard-overdue-section">
                <div class="dashboard-section-header">
                    <h2>Überfällig</h2>
                    <span class="dashboard-count">@Model.Dashboard.OverdueBlocks.Count</span>
                </div>

                @if (Model.Dashboard.OverdueBlocks.Count == 0)
                {
                    <p class="empty-block-message">Keine überfälligen Aufgaben vorhanden.</p>
                }
                else
                {
                    <div class="dashboard-block-list">
                        @foreach (var block in Model.Dashboard.OverdueBlocks)
                        {
                            <a asp-page="/Tasks/TaskView"
                               asp-route-id="@block.TaskId"
                               asp-route-focusDate="@block.Start.ToString("yyyy-MM-dd")"
                               asp-route-selectedBlockId="@block.BlockId"
                               class="dashboard-block @block.CssClass">
                                <span class="dashboard-block-task-name">@block.TaskName</span>

                                <span class="dashboard-block-meta">
                                    <span>@block.DisplayTime</span>
                                    <span class="dashboard-block-status">@block.StatusText</span>
                                </span>
                            </a>
                        }
                    </div>

                    
                }
            </section>

            <section class="dashboard-section">
                <div class="dashboard-section-header">
                    <h2>Heute</h2>
                    <span class="dashboard-count">@Model.Dashboard.TodayBlocks.Count</span>
                </div>

                @if (Model.Dashboard.TodayBlocks.Count == 0)
                {
                    <p class="empty-block-message">Für heute sind keine offenen Aufgaben vorhanden.</p>
                }
                else
                {
                    <div class="dashboard-block-list">
                        @foreach (var block in Model.Dashboard.TodayBlocks)
                        {
                            <a asp-page="/Tasks/TaskView"
                               asp-route-id="@block.TaskId"
                               asp-route-focusDate="@block.Start.ToString("yyyy-MM-dd")"
                               asp-route-selectedBlockId="@block.BlockId"
                               class="dashboard-block @block.CssClass">
                                <span class="dashboard-block-task-name">@block.TaskName</span>

                                <span class="dashboard-block-meta">
                                    <span>@block.DisplayTime</span>
                                    <span class="dashboard-block-status">@block.StatusText</span>
                                </span>
                            </a>
                        }
                    </div>

                    
                }
            </section>

            <section class="dashboard-section">
                <div class="dashboard-section-header">
                    <h2>Demnächst</h2>
                    <span class="dashboard-count">@Model.Dashboard.UpcomingBlocks.Count</span>
                </div>

                @if (Model.Dashboard.UpcomingBlocks.Count == 0)
                {
                    <p class="empty-block-message">Für die nächsten sieben Tage sind keine offenen Aufgaben vorhanden.</p>
                }
                else
                {
                    <div class="dashboard-block-list">
                        @foreach (var block in Model.Dashboard.UpcomingBlocks)
                        {
                            <a asp-page="/Tasks/TaskView"
                               asp-route-id="@block.TaskId"
                               asp-route-focusDate="@block.Start.ToString("yyyy-MM-dd")"
                               asp-route-selectedBlockId="@block.BlockId"
                               class="dashboard-block @block.CssClass">
                                <span class="dashboard-block-task-name">@block.TaskName</span>

                                <span class="dashboard-block-meta">
                                    <span>@block.DisplayTime</span>
                                    <span class="dashboard-block-status">@block.StatusText</span>
                                </span>
                            </a>
                        }
                    </div>

                    
                }
            </section>
        </div>

        <form method="post" id="demoDataAntiForgeryForm">
            @Html.AntiForgeryToken()
        </form>

        <div id="demoDataLoading" class="loading-overlay" style="display: none;">
            <div class="loading-spinner"></div>
            <div class="loading-text">Demo-Daten werden erstellt...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var createDemoDataButton = document.getElementById('createDemoDataButton');

            if (!createDemoDataButton) {
                return;
            }

            var loadingOverlay = document.getElementById('demoDataLoading');

            createDemoDataButton.addEventListener('click', function () {
                if (!confirm('Sollen wirklich Demo-Benutzer, Aufgaben und Blöcke angelegt werden? Diese Aktion kann nicht rückgängig gemacht werden.')) {
                    return;
                }

                loadingOverlay.style.display = 'flex';
                createDemoDataButton.disabled = true;

                var formData = new FormData();
                var requestVerificationToken = document.querySelector('input[name="__RequestVerificationToken"]');

                if (requestVerificationToken) {
                    formData.append('__RequestVerificationToken', requestVerificationToken.value);
                }

                fetch('@Url.Page("/Index")', {
                    method: 'POST',
                    body: formData
                })
                .then(function (response) {
                    if (response.ok) {
                        window.location.reload();
                        return;
                    }

                    alert('Beim Anlegen der Demo-Daten ist ein Fehler aufgetreten.');
                    loadingOverlay.style.display = 'none';
                    createDemoDataButton.disabled = false;
                })
                .catch(function () {
                    alert('Beim Anlegen der Demo-Daten ist ein Fehler aufgetreten.');
                    loadingOverlay.style.display = 'none';
                    createDemoDataButton.disabled = false;
                });
            });
        });
    </script>
}