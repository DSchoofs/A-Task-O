@page
@model Schoofs_ATaskO.Pages.Admin.Users.UserManagementModel

@{
    ViewData["Title"] = "Benutzerverwaltung";
}
<div class="page-container">
    <div class="form-container wide-container">
        <div class="page-header">
            <h1>Benutzerverwaltung</h1>
            
                <a asp-page="./Create" class="action-button create-button">Neuen Benutzer anlegen</a>
           
        </div>
        

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.Users == null || Model.Users.Count == 0)
        {
            <p>Keine Benutzer vorhanden.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Nutzer ID</th>
                            <th>Vorname</th>
                            <th>Nachname</th>
                            <th>E-Mail</th>
                            <th>Admin</th>
                            <th>Letzter Login</th>
                            <th>Abgeschlossene Aufgaben</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.UserId</td>
                                <td>@user.FirstName</td>
                                <td>@user.LastName</td>
                                <td>@user.Email</td>
                                <td>@(user.IsAdmin ? "Ja" : "Nein")</td>
                                <td>@(user.LastLogin.HasValue ? user.LastLogin.Value.ToString("dd.MM.yyyy HH:mm") : "Nie")</td>
                                <td>@(user.CompletedTasks.HasValue ? user.CompletedTasks.Value.ToString() : "0")</td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-page="./Edit" asp-route-id="@user.UserId" class="action-button edit-button">Bearbeiten</a>
                                        <a asp-page="./Delete" asp-route-id="@user.UserId" class="action-button delete-button">Löschen</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>