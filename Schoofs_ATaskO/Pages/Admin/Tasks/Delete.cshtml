@page "{id:int}"
@model Schoofs_ATaskO.Pages.Admin.Tasks.DeleteModel

@{
    ViewData["Title"] = "Aufgabe löschen";
}

<div class="page-container">
    <div class="form-container wide-container">
        <div class="page-header">
            <h1>Aufgabe löschen</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">
                @Model.ErrorMessage
            </div>
        }

        <div class="warning-message">
            <p>
                Möchten Sie diese Aufgabe wirklich endgültig löschen?
            </p>

            <p>
                Dabei werden auch alle zugehörigen Aufgabenblöcke dauerhaft
                aus der Datenbank gelöscht.
            </p>

            <p>
                Wenn Sie die Aufgabe und ihre Blockhistorie behalten möchten,
                deaktivieren Sie sie stattdessen über die Bearbeiten-Seite.
            </p>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle form-table">
                <tbody>
                    <tr>
                        <th>Name</th>
                        <td>@Model.Input.Name</td>
                    </tr>

                    <tr>
                        <th>Beschreibung</th>
                        <td>
                            @(string.IsNullOrWhiteSpace(Model.Input.Description) ? "Keine Beschreibung" : Model.Input.Description)
                        </td>
                    </tr>

                    <tr>
                        <th>Intervall</th>
                        <td>@Model.Input.Interval</td>
                    </tr>

                    <tr>
                        <th>Status</th>
                        <td>
                            @(Model.Input.IsActive ? "Aktiv" : "Inaktiv")
                        </td>
                    </tr>

                    <tr>
                        <th>Erstellt von</th>
                        <td>@Model.Input.CreatedByUserName</td>
                    </tr>

                    <tr>
                        <th>Erstellt am</th>
                        <td>
                            @Model.Input.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </td>
                    </tr>

                    <tr>
                        <th>Geändert von</th>
                        <td>@Model.Input.ModifiedByUserName</td>
                    </tr>

                    <tr>
                        <th>Geändert am</th>
                        <td>
                            @(Model.Input.ModifiedAt.HasValue ? Model.Input.ModifiedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Noch nicht geändert")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Input.Id" />

            <div class="form-actions">
                <button type="submit" class="delete-button">
                    Aufgabe endgültig löschen
                </button>

                <a asp-page="TaskManagement" class="cancel-button">
                    Abbrechen
                </a>
            </div>
        </form>
    </div>
</div>