@page
@model Schoofs_ATaskO.Pages.Admin.Tasks.CreateModel

@using Schoofs_ATaskO.Models

@{
    ViewData["Title"] = "Aufgabe anlegen";
}

<div class="page-container">
    <div class="form-container wide-container">
        <div class="page-header">
            <h1>Aufgabe anlegen</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">
                @Model.ErrorMessage
            </div>
        }

        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle form-table">
                    <tbody>
                        <tr>
                            <th>
                                <label asp-for="Input.Name"></label>
                            </th>
                            <td>
                                <input asp-for="Input.Name" class="form-control" />
                                <span asp-validation-for="Input.Name"
                                      class="text-danger"></span>
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <label asp-for="Input.Description"></label>
                            </th>
                            <td>
                                <textarea asp-for="Input.Description"
                                          class="form-control"
                                          rows="4"></textarea>

                                <span asp-validation-for="Input.Description"
                                      class="text-danger"></span>
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <label asp-for="Input.Interval"></label>
                            </th>
                            <td>
                                <select asp-for="Input.Interval"
                                        asp-items="Html.GetEnumSelectList<TaskInterval>()"
                                        class="form-select">
                                </select>

                                <span asp-validation-for="Input.Interval"
                                      class="text-danger"></span>
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <label asp-for="Input.WeekMode"></label>
                            </th>
                            <td>
                                <select asp-for="Input.WeekMode"
                                        asp-items="Html.GetEnumSelectList<TaskWeekMode>()"
                                        class="form-select">
                                    <option value="">Bitte auswählen</option>
                                </select>

                                <span asp-validation-for="Input.WeekMode"
                                      class="text-danger"></span>

                                <small class="form-hint">
                                    Wird nur bei wöchentlichem Intervall verwendet. 
                                </small>
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <label asp-for="Input.IsActive"></label>
                            </th>
                            <td>
                                <div class="form-check">
                                    <input asp-for="Input.IsActive"
                                           class="form-check-input" />

                                    <label asp-for="Input.IsActive"
                                           class="form-check-label">
                                    </label>
                                </div>

                                <span asp-validation-for="Input.IsActive"
                                      class="text-danger"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="form-actions">
                <button type="submit" class="save-button">
                    Speichern
                </button>

                <a asp-page="TaskManagement" class="cancel-button">
                    Abbrechen
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}