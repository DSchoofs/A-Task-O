@page "{id:int}"
@model Schoofs_ATaskO.Pages.Admin.Tasks.EditModel
@using Schoofs_ATaskO.Models
@{
    ViewData["Title"] = "Aufgabe bearbeiten";
}

<div class="page-container">
    <div class="form-container">
        <h1>Aufgabe bearbeiten</h1>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">@Model.ErrorMessage</div>
        }

        <form method="post">
            <input asp-for="ViewModel.TaskId" type="hidden" />

            <div class="form-group">
                <label asp-for="ViewModel.TaskName"></label>
                <input asp-for="ViewModel.TaskName" class="form-input" />
                <span asp-validation-for="ViewModel.TaskName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ViewModel.TaskInterval"></label>
                <select asp-for="ViewModel.TaskInterval"
                        asp-items="Html.GetEnumSelectList<TaskInterval>()"
                        class="form-input">
                    <option value="">Bitte wählen</option>
                </select>
                <span asp-validation-for="ViewModel.TaskInterval" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="save-button">Speichern</button>
                <a asp-page="/Admin/Tasks/TaskManagement" class="cancel-button">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}