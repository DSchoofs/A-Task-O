@page
@model Schoofs_ATaskO.Pages.Admin.Tasks.TaskManagementModel
@{
    ViewData["Title"] = "Aufgabenverwaltung";
}

<div class="page-container">
    <div class="form-container wide-container">
        <div class="page-header">
            <h1>Aufgabenverwaltung</h1>
            <a asp-page="/Admin/Tasks/Create" class="save-button">Neue Aufgabe anlegen</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">@Model.ErrorMessage</div>
        }

        @if (Model.Tasks.Count == 0)
        {
            <p>Es sind aktuell keine Aufgaben vorhanden.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table task-management-table table-striped table-hover table-bordered">
                    <colgroup>
                        <col class="col-name" />
                        <col class="col-description" />
                        <col class="col-interval" />
                        <col class="col-status" />
                        <col class="col-createdby" />
                        <col class="col-createdat" />
                        <col class="col-modifiedby" />
                        <col class="col-modifiedat" />
                        <col class="col-actions" />
                    </colgroup>

                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Beschreibung</th>
                            <th>Intervall</th>
                            <th>Status</th>
                            <th>Erstellt von</th>
                            <th>Erstellt am</th>
                            <th>Geändert von</th>
                            <th>Geändert am</th>
                            <th>Aktionen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.Tasks)
                        {
                            <tr>
                                <td class="name-column">
                                    <div class="name-box">
                                        @task.Name
                                    </div>
                                </td>

                                <td class="description-column">
                                    <div class="description-box">
                                        @(string.IsNullOrWhiteSpace(task.Description)
                                            ? "Keine Beschreibung"
                                            : task.Description)
                                    </div>
                                </td>

                                
                                <td>@task.Interval</td>

                                <td>
                                    @(task.IsActive ? "Aktiv" : "Inaktiv")
                                </td>

                                <td>@task.CreatedByUserName</td>

                                <td>
                                    @task.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>@task.ModifiedByUserName</td>

                                <td>
                                    @(task.ModifiedAt.HasValue ? task.ModifiedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Noch nicht geändert")
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <a asp-page="Edit"
                                           asp-route-id="@task.Id"
                                           class="btn btn-primary btn-sm">
                                            Bearbeiten
                                        </a>

                                        <a asp-page="Delete"
                                           asp-route-id="@task.Id"
                                           class="btn btn-danger btn-sm">
                                            Löschen
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>