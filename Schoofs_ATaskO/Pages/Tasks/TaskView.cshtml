@page "{id:int}"
@model Schoofs_ATaskO.Pages.Tasks.TaskViewModel

@using Schoofs_ATaskO.Models

@{
    ViewData["Title"] = Model.TaskView?.Name ?? "Aufgabe";
}

<div class="page-container">
    <div class="form-container wide-container">

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">
                @Model.ErrorMessage
            </div>
        }
        else if (Model.TaskView != null)
        {
            <div class="page-header">
                <div>
                    <h1>@Model.TaskView.Name</h1>

                    <p class="task-view-subtitle">
                        Aufgaben-ID: @Model.TaskView.TaskId
                    </p>
                </div>
            </div>

            <div class="task-details">
                <div class="task-detail-row">
                    <span class="task-detail-label">
                        Intervall:
                    </span>

                    <span>
                        @Model.TaskView.Interval.GetDisplayName()
                    </span>
                </div>

                @if (Model.TaskView.Interval == TaskInterval.Weekly)
                {
                    <div class="task-detail-row">
                        <span class="task-detail-label">
                            Wochenendregel:
                        </span>

                        <span>
                            @Model.TaskView.WeekMode.GetDisplayName()
                        </span>
                    </div>
                }

                <div class="task-detail-row">
                    <span class="task-detail-label">
                        Status:
                    </span>

                    <span>
                        @(Model.TaskView.IsActive ? "Aktiv" : "Inaktiv")
                    </span>
                </div>

                <div class="task-detail-description">
                    <span class="task-detail-label">
                        Beschreibung:
                    </span>

                    @if (string.IsNullOrWhiteSpace(Model.TaskView.Description))
                    {
                        <span class="description-preview-empty">
                            Keine Beschreibung vorhanden.
                        </span>
                    }
                    else
                    {
                        <button type="button"
                                class="description-button"
                                data-description-open
                                data-description-title="@Model.TaskView.Name"
                                data-description="@Model.TaskView.Description">
                            Beschreibung öffnen
                        </button>
                    }
                </div>
            </div>

            <div class="task-view-navigation">
                <a asp-page="/Tasks/TaskView"
                   asp-route-id="@Model.TaskView.TaskId"
                   asp-route-focusDate="@Model.TaskView.PreviousFocusDate.ToString("yyyy-MM-dd")"
                   class="period-navigation-button">
                    ← Zurück
                </a>

                <a asp-page="/Tasks/TaskView"
                   asp-route-id="@Model.TaskView.TaskId"
                   asp-route-focusDate="@Model.TaskView.NextFocusDate.ToString("yyyy-MM-dd")"
                   class="period-navigation-button">
                    Weiter →
                </a>
            </div>

            <div class="task-periods">

                <section class="task-period">
                    <h2>
                        @Model.TaskView.PreviousPeriodTitle
                    </h2>

                    <div class="task-period-label">
                        @if (Model.TaskView.Interval == TaskInterval.Daily)
                        {
                            @Model.TaskView.PreviousPeriodDateRange
                        }
                        else
                        {
                            @Model.TaskView.PreviousPeriodLabel
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.TaskView.PreviousCalendarWeek))
                    {
                        <div class="task-period-calendar-week">
                            @Model.TaskView.PreviousCalendarWeek
                        </div>
                    }

                    @if (Model.TaskView.PreviousBlocks.Count == 0)
                    {
                        <p class="empty-block-message">
                            Keine Blöcke vorhanden.
                        </p>
                    }
                    else
                    {
                        foreach (var block in Model.TaskView.PreviousBlocks)
                        {
                            <button type="button"
                                    class="task-block @block.CssClass @(block.IsSelected ? "task-block-selected" : string.Empty)"
                                    data-block-id="@block.Id"
                                    data-display-time="@block.DisplayTime"
                                    data-status="@block.StatusText"
                                    data-assigned-user="@block.AssignedByUserName"
                                    data-assigned-at="@((block.AssignedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")) ?? string.Empty)"
                                    data-completed-user="@block.CompletedByUserName"
                                    data-completed-at="@((block.CompletedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")) ?? string.Empty)"
                                    data-note="@block.Note"
                                    data-can-be-taken-over="@block.CanBeTakenOver.ToString().ToLowerInvariant()"
                                    data-can-be-completed="@block.CanBeCompleted.ToString().ToLowerInvariant()"
                                    data-can-be-released="@block.CanBeReleased.ToString().ToLowerInvariant()">

                                <span class="task-block-time">
                                    @block.DisplayTime
                                </span>

                                <span class="task-block-status">
                                    @block.StatusText
                                </span>
                            </button>
                        }
                    }
                </section>

                <section class="task-period current-period">
                    <h2>
                        @Model.TaskView.CurrentPeriodTitle
                    </h2>

                    <div class="task-period-label">
                        @if (Model.TaskView.Interval == TaskInterval.Daily)
                        {
                            @Model.TaskView.CurrentPeriodDateRange
                        }
                        else
                        {
                            @Model.TaskView.CurrentPeriodLabel
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.TaskView.CurrentCalendarWeek))
                    {
                        <div class="task-period-calendar-week">
                            @Model.TaskView.CurrentCalendarWeek
                        </div>
                    }

                    @if (Model.TaskView.CurrentBlocks.Count == 0)
                    {
                        <p class="empty-block-message">
                            Keine Blöcke vorhanden.
                        </p>
                    }
                    else
                    {
                        foreach (var block in Model.TaskView.CurrentBlocks)
                        {
                            <button type="button"
                                    class="task-block @block.CssClass @(block.IsSelected ? "task-block-selected" : string.Empty)"
                                    data-block-id="@block.Id"
                                    data-display-time="@block.DisplayTime"
                                    data-status="@block.StatusText"
                                    data-assigned-user="@block.AssignedByUserName"
                                    data-assigned-at="@((block.AssignedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")) ?? string.Empty)"
                                    data-completed-user="@block.CompletedByUserName"
                                    data-completed-at="@((block.CompletedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")) ?? string.Empty)"
                                    data-note="@block.Note"
                                    data-can-be-taken-over="@block.CanBeTakenOver.ToString().ToLowerInvariant()"
                                    data-can-be-completed="@block.CanBeCompleted.ToString().ToLowerInvariant()"
                                    data-can-be-released="@block.CanBeReleased.ToString().ToLowerInvariant()">

                                <span class="task-block-time">
                                    @block.DisplayTime
                                </span>

                                <span class="task-block-status">
                                    @block.StatusText
                                </span>
                            </button>
                        }
                    }
                </section>

                <section class="task-period">
                    <h2>
                        @Model.TaskView.NextPeriodTitle
                    </h2>

                    <div class="task-period-label">
                        @if (Model.TaskView.Interval == TaskInterval.Daily)
                        {
                            @Model.TaskView.NextPeriodDateRange
                        }
                        else
                        {
                            @Model.TaskView.NextPeriodLabel
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.TaskView.NextCalendarWeek))
                    {
                        <div class="task-period-calendar-week">
                            @Model.TaskView.NextCalendarWeek
                        </div>
                    }

                    @if (Model.TaskView.NextBlocks.Count == 0)
                    {
                        <p class="empty-block-message">
                            Keine Blöcke vorhanden.
                        </p>
                    }
                    else
                    {
                        foreach (var block in Model.TaskView.NextBlocks)
                        {
                            <button type="button"
                                    class="task-block @block.CssClass @(block.IsSelected ? "task-block-selected" : string.Empty)"
                                    data-block-id="@block.Id"
                                    data-display-time="@block.DisplayTime"
                                    data-status="@block.StatusText"
                                    data-assigned-user="@block.AssignedByUserName"
                                    data-assigned-at="@((block.AssignedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")) ?? string.Empty)"
                                    data-completed-user="@block.CompletedByUserName"
                                    data-completed-at="@((block.CompletedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")) ?? string.Empty)"
                                    data-note="@block.Note"
                                    data-can-be-taken-over="@block.CanBeTakenOver.ToString().ToLowerInvariant()"
                                    data-can-be-completed="@block.CanBeCompleted.ToString().ToLowerInvariant()"
                                    data-can-be-released="@block.CanBeReleased.ToString().ToLowerInvariant()">

                                <span class="task-block-time">
                                    @block.DisplayTime
                                </span>

                                <span class="task-block-status">
                                    @block.StatusText
                                </span>
                            </button>
                        }
                    }
                </section>
            </div>

            <div id="taskBlockDetails"
                 class="task-details task-block-details"
                 hidden>

                <div class="task-block-details-header">
                    <div>
                        <h2>
                            Blockdetails
                        </h2>

                        <p class="task-block-details-time"
                           id="selectedBlockDisplayTime">
                        </p>
                    </div>
                </div>

                <div class="task-detail-row">
                    <span class="task-detail-label">
                        Status:
                    </span>

                    <span id="selectedBlockStatus"></span>
                </div>

                <div id="selectedBlockAssignedUserRow"
                     class="task-detail-row"
                     hidden>

                    <span class="task-detail-label">
                        Übernommen von:
                    </span>

                    <span id="selectedBlockAssignedUser"></span>
                </div>

                <div id="selectedBlockAssignedAtRow"
                     class="task-detail-row"
                     hidden>

                    <span class="task-detail-label">
                        Übernommen am:
                    </span>

                    <span id="selectedBlockAssignedAt"></span>
                </div>

                <div id="selectedBlockCompletedUserRow"
                     class="task-detail-row"
                     hidden>

                    <span class="task-detail-label">
                        Erledigt von:
                    </span>

                    <span id="selectedBlockCompletedUser"></span>
                </div>

                <div id="selectedBlockCompletedAtRow"
                     class="task-detail-row"
                     hidden>

                    <span class="task-detail-label">
                        Erledigt am:
                    </span>

                    <span id="selectedBlockCompletedAt"></span>
                </div>

                <div id="selectedBlockNoteRow"
                     class="task-detail-row"
                     hidden>

                    <span class="task-detail-label">
                        Notiz:
                    </span>

                    <span id="selectedBlockNote"></span>
                </div>

                <div class="form-actions">
                    <form method="post"
                          asp-page-handler="TakeOver"
                          id="takeOverBlockForm"
                          hidden>

                        <input type="hidden"
                               name="id"
                               value="@Model.TaskView.TaskId" />

                        <input type="hidden"
                               name="blockId"
                               id="selectedBlockId" />

                        <input type="hidden"
                               name="focusDate"
                               value="@Model.TaskView.FocusDate.ToString("yyyy-MM-dd")" />

                        <button type="submit"
                                class="save-button">
                            Block übernehmen
                        </button>
                    </form>

                    <form method="post"
                          asp-page-handler="Complete"
                          id="completeBlockForm"
                          hidden>

                        <input type="hidden"
                               name="id"
                               value="@Model.TaskView.TaskId" />

                        <input type="hidden"
                               name="blockId"
                               id="completedBlockId" />

                        <input type="hidden"
                               name="focusDate"
                               value="@Model.TaskView.FocusDate.ToString("yyyy-MM-dd")" />

                        <button type="submit"
                                class="save-button">
                            Erledigt markieren
                        </button>
                    </form>

                    <form method="post"
                          asp-page-handler="Release"
                          id="releaseBlockForm"
                          hidden>

                        <input type="hidden"
                               name="id"
                               value="@Model.TaskView.TaskId" />

                        <input type="hidden"
                               name="blockId"
                               id="releasedBlockId" />

                        <input type="hidden"
                               name="focusDate"
                               value="@Model.TaskView.FocusDate.ToString("yyyy-MM-dd")" />

                        <button type="submit"
                                class="cancel-button">
                            Block freigeben
                        </button>
                    </form>
                </div>
            </div>

            <div class="task-legend">
                <h2>
                    Legende
                </h2>

                <div class="legend-items">
                    <span class="legend-item">
                        <span class="legend-color block-free"></span>
                        Frei
                    </span>

                    <span class="legend-item">
                        <span class="legend-color block-mine"></span>
                        Von mir übernommen
                    </span>

                    <span class="legend-item">
                        <span class="legend-color block-other"></span>
                        Von anderem Benutzer übernommen
                    </span>

                    <span class="legend-item">
                        <span class="legend-color block-overdue"></span>
                        Überfällig
                    </span>

                    <span class="legend-item">
                        <span class="legend-color block-completed"></span>
                        Erledigt
                    </span>
                </div>
            </div>

            <div class="form-actions">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin/Tasks/Edit"
                       asp-route-id="@Model.TaskView.TaskId"
                       class="edit-button">
                        Aufgabe bearbeiten
                    </a>
                }

                <a asp-page="/Index"
                   class="cancel-button">
                    Zurück zum Dashboard
                </a>
            </div>
        }
    </div>
</div>

<div id="descriptionOverlay"
     class="description-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="descriptionDialogTitle">

    <div class="description-dialog">
        <div class="description-dialog-header">
            <h2 id="descriptionDialogTitle">
                Beschreibung
            </h2>

            <button type="button"
                    class="description-close-button"
                    data-description-close
                    aria-label="Beschreibung schließen">
                ×
            </button>
        </div>

        <textarea id="descriptionText"
                  class="description-textarea"
                  readonly></textarea>

        <div class="description-dialog-actions">
            <button type="button"
                    class="cancel-button"
                    data-description-close>
                Schließen
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const blocks = document.querySelectorAll(".task-block");

        const details = document.getElementById("taskBlockDetails");

        const takeoverForm = document.getElementById("takeOverBlockForm");
        const completeForm = document.getElementById("completeBlockForm");
        const releaseForm = document.getElementById("releaseBlockForm");

        const selectedBlockId = document.getElementById("selectedBlockId");
        const completedBlockId = document.getElementById("completedBlockId");
        const releasedBlockId = document.getElementById("releasedBlockId");

        const displayTime = document.getElementById("selectedBlockDisplayTime");
        const status = document.getElementById("selectedBlockStatus");

        const assignedUserRow = document.getElementById("selectedBlockAssignedUserRow");
        const assignedUser = document.getElementById("selectedBlockAssignedUser");

        const assignedAtRow = document.getElementById("selectedBlockAssignedAtRow");
        const assignedAt = document.getElementById("selectedBlockAssignedAt");

        const completedUserRow = document.getElementById("selectedBlockCompletedUserRow");
        const completedUser = document.getElementById("selectedBlockCompletedUser");

        const completedAtRow = document.getElementById("selectedBlockCompletedAtRow");
        const completedAt = document.getElementById("selectedBlockCompletedAt");

        const noteRow = document.getElementById("selectedBlockNoteRow");
        const note = document.getElementById("selectedBlockNote");

        blocks.forEach(function(block) {
            block.addEventListener("click", function() {
                blocks.forEach(function(item) {
                    item.classList.remove("task-block-selected");
                });

                block.classList.add("task-block-selected");

                displayTime.textContent = block.dataset.displayTime;
                status.textContent = block.dataset.status;

                selectedBlockId.value = block.dataset.blockId;
                completedBlockId.value = block.dataset.blockId;
                releasedBlockId.value = block.dataset.blockId;

                if (block.dataset.assignedUser) {
                    assignedUser.textContent = block.dataset.assignedUser;
                    assignedUserRow.hidden = false;
                }
                else {
                    assignedUser.textContent = "";
                    assignedUserRow.hidden = true;
                }

                if (block.dataset.assignedAt) {
                    assignedAt.textContent = block.dataset.assignedAt;
                    assignedAtRow.hidden = false;
                }
                else {
                    assignedAt.textContent = "";
                    assignedAtRow.hidden = true;
                }

                if (block.dataset.completedUser) {
                    completedUser.textContent = block.dataset.completedUser;
                    completedUserRow.hidden = false;
                }
                else {
                    completedUser.textContent = "";
                    completedUserRow.hidden = true;
                }

                if (block.dataset.completedAt) {
                    completedAt.textContent = block.dataset.completedAt;
                    completedAtRow.hidden = false;
                }
                else {
                    completedAt.textContent = "";
                    completedAtRow.hidden = true;
                }

                if (block.dataset.note) {
                    note.textContent = block.dataset.note;
                    noteRow.hidden = false;
                }
                else {
                    note.textContent = "";
                    noteRow.hidden = true;
                }

                takeoverForm.hidden =
                    block.dataset.canBeTakenOver !== "true";

                completeForm.hidden =
                    block.dataset.canBeCompleted !== "true";

                releaseForm.hidden =
                    block.dataset.canBeReleased !== "true";

                details.hidden = false;

                details.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest"
                });
            });
        });

        const descriptionOverlay = document.getElementById("descriptionOverlay");
        const descriptionText = document.getElementById("descriptionText");
        const descriptionTitle = document.getElementById("descriptionDialogTitle");
        const descriptionOpenButton = document.querySelector("[data-description-open]");
        const descriptionCloseButtons = document.querySelectorAll("[data-description-close]");

        if (descriptionOpenButton) {
            descriptionOpenButton.addEventListener("click", function() {
                descriptionTitle.textContent =
                    descriptionOpenButton.dataset.descriptionTitle;

                descriptionText.value =
                    descriptionOpenButton.dataset.description;

                descriptionOverlay.classList.add("is-open");
                document.body.classList.add("description-overlay-open");
            });
        }

        descriptionCloseButtons.forEach(function(button) {
            button.addEventListener("click", function() {
                descriptionOverlay.classList.remove("is-open");
                document.body.classList.remove("description-overlay-open");
            });
        });

        descriptionOverlay.addEventListener("click", function(event) {
            if (event.target === descriptionOverlay) {
                descriptionOverlay.classList.remove("is-open");
                document.body.classList.remove("description-overlay-open");
            }
        });
    });
</script>