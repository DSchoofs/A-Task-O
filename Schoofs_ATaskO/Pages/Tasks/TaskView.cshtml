@page "{id:int}"
@model Schoofs_ATaskO.Pages.Tasks.TaskViewModel
@{
    ViewData["Title"] = Model.TaskItem?.Name ?? "Aufgabe";
}

<div class="page-container">
    <div class="form-container wide-container">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message">@Model.ErrorMessage</div>
        }
        else if (Model.TaskItem != null)
        {
            <h1>@Model.TaskItem.Name</h1>

            <div class="task-details">
                <p><strong>Aufgaben-ID:</strong> @Model.TaskItem.Id</p>
                <p><strong>Intervall:</strong> @Model.TaskItem.Interval.GetDisplayName()</p>
            </div>

            <div class="form-actions">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin/Tasks/Edit" asp-route-id="@Model.TaskItem.Id" class="edit-button">
                        Aufgabe bearbeiten
                    </a>
                }

                <a asp-page="/Index" class="cancel-button">Zurück zum Dashboard</a>
            </div>
        }
    </div>
</div>