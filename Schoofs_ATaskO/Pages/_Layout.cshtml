@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - A-Task-O</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-left">
            <img src="~/image/AtaskoLogo.jpg" alt="A-Task-O Logo" class="logo" />
        </div>

        <div class="topbar-center">
            <div class="app-title">A-Task-O</div>
            <div class="app-subtitle">All Tasks Organized</div>
        </div>

        <div class="topbar-right">
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="logout-button">Logout</button>
            </form>
        </div>
    </header>

    <div class="layout">
        <aside class="sidebar">
            <nav class="sidebar-nav">
                <a asp-page="/Index">Dashboard</a>
                <a asp-page="/Login">Login</a>
                <a asp-page="/Admin/Users/UserManagement">Benutzerverwaltung</a>
            </nav>
        </aside>

        <main class="content">
            @RenderBody()
        </main>
    </div>
    <footer class="footer">
        <p>&copy; 2026 A-Task-O</p>
    </footer>
</body>
</html>