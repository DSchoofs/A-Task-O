@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-left">
            <img src="~/image/AtaskoLogo.jpg" alt="A-Task-O Logo" class="logo" />
        </div>
        <div class="topbar-center">
            <div class="app-title">A-Task-O</div>
            <div class="app-subtitle">All Tasks Organized</div>
        </div>

        <div class="topbar-right">
            <a asp-page="/Logout" class="logout-button">Logout</a>
        </div>
    </header>

    <div class="layout">
        <aside class="sidebar">
            <nav>
                <a asp-page="/Index">Dashboard</a>
                <a asp-page="/Login">Login</a>
            </nav>
        </aside>

        <main class="content">
            @RenderBody()
        </main>
    </div>
    <footer>
        <p>&copy; 2026 Razor Layout</p>
    </footer>
</body>
</html>